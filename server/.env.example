# Copy to server/.env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/shl_english

# Angular dev server origin (CORS) and public URL used in emails (password reset links)
CLIENT_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200

# Auth — use long random strings in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# true when served over HTTPS
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Email (optional). Empty = reset links are printed to the server log.
# Example: smtp://user:pass@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM="SHL English Practice <no-reply@example.com>"

# AI question writer (optional, free options). Leave LLM_BASE_URL empty to turn it off.
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<a Groq model id>
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<a Gemini model id>
#   Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (no key needed)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Speech-to-text for spoken answers (recommended). Any OpenAI-compatible Whisper API:
#   Groq (free tier):  STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=<a Groq Whisper model id>
#   Self-hosted:       STT_BASE_URL=http://localhost:8000/v1          STT_MODEL=<the model your server loads>
# Leave empty to use the browser's own speech recognition (Chrome/Edge only, less precise).
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
# How many days students' recordings are kept
RECORDING_RETENTION_DAYS=60
# Optional grammar double-check for AI drafts: docker compose --profile ai up -d languagetool
LANGUAGETOOL_URL=

# Serve the built Angular app from Express (single deployment)
SERVE_CLIENT=false

# Used by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
