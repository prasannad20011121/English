# Used by `docker compose` (copy to .env). For `npm run dev`, use server/.env.example instead.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
APP_URL=http://localhost:3000
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional SMTP for password-reset emails, e.g. smtp://user:pass@smtp-relay.brevo.com:587
SMTP_URL=
